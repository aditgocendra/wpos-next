// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  WAREHOUSE_ADMIN
  CASHIER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  TRANSFERED
  CANCELLED
}

model User {
  id                  String           @id @default(cuid())
  name                String?
  email               String           @unique
  password            String
  role                Role             @default(CASHIER)
  status              UserStatus       @default(ACTIVE)
  warehouseId         String?          @unique
  warehouse           Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  productsCreated     Product[]        @relation("ProductCreatedBy")
  productsUpdated     Product[]        @relation("ProductUpdatedBy")
  variantsCreated     ProductVariant[] @relation("VariantCreatedBy")
  variantsUpdated     ProductVariant[] @relation("VariantUpdatedBy")
  transfersCreated    StockTransfer[]  @relation("TransfersCreated")
  transfersUpdated    StockTransfer[]  @relation("TransfersUpdated")
  transactionsCreated Transaction[]    @relation("TransactionsCreated")
  transactionsUpdated Transaction[]    @relation("TransactionsUpdated")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("users")
}

model Warehouse {
  id                   String                @id @default(cuid())
  name                 String
  code                 String?               @unique
  address              String?
  admin                User?
  sourceTransfers      StockTransfer[]       @relation("SourceTransfers")
  destinationTransfers StockTransfer[]       @relation("DestinationTransfers")
  transactions         Transaction[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  productVariantStocks ProductVariantStock[]

  @@map("warehouses")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

model Product {
  id               String              @id @default(cuid())
  name             String
  categoryId       String
  variants         ProductVariant[]
  transferItems    StockTransferItem[]
  transactionItems TransactionItem[]

  category Category @relation(fields: [categoryId], references: [id])

  createdById String
  updatedById String?
  createdBy   User    @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?   @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id          String @id @default(cuid())
  productId   String
  variantName String // contoh: "Hitam", "Putih", "64GB", dll
  sku         String // Format: CODE1-CODE2-CODE3-CODE4
  priceSell   Float  @default(0.0)
  priceCost   Float  @default(0.0)

  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  transferItems    StockTransferItem[]
  transactionItems TransactionItem[]
  warehouseStocks  ProductVariantStock[]

  createdById String
  updatedById String?
  createdBy   User    @relation("VariantCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?   @relation("VariantUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductVariantStock {
  id          String @id @default(cuid())
  variantId   String
  warehouseId String
  stock       Int    @default(0)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("product_variant_stocks")
}

model StockTransfer {
  id                     String         @id @default(cuid())
  transferNumber         String         @unique
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 TransferStatus @default(PENDING)
  notes                  String?
  createdById            String
  updatedById            String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  sourceWarehouse      Warehouse           @relation("SourceTransfers", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse           @relation("DestinationTransfers", fields: [destinationWarehouseId], references: [id])
  createdBy            User                @relation("TransfersCreated", fields: [createdById], references: [id])
  updatedBy            User?               @relation("TransfersUpdated", fields: [updatedById], references: [id])
  items                StockTransferItem[]

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String   @id @default(cuid())
  transferId String
  productId  String
  variantId  String
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@index([variantId])
  @@map("stock_transfer_items")
}

model Transaction {
  id                String            @id @default(cuid())
  transactionNumber String            @unique
  warehouseId       String
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id])
  totalAmount       Float             @default(0.0)
  notes             String?
  createdById       String
  updatedById       String?
  createdBy         User              @relation("TransactionsCreated", fields: [createdById], references: [id])
  updatedBy         User?             @relation("TransactionsUpdated", fields: [updatedById], references: [id])
  items             TransactionItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([warehouseId])
  @@index([createdById])
  @@map("transactions")
}

model TransactionItem {
  id            String @id @default(cuid())
  transactionId String
  productId     String
  variantId     String
  quantity      Int
  price         Float  @default(0.0) // Selling price snapshot
  totalPrice    Float  @default(0.0) // price * quantity
  costPrice     Float  @default(0.0) // Cost price snapshot (HPP)

  transaction Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([productId])
  @@index([variantId])
  @@map("transaction_items")
}
